# Copy to ~/.hermes/.env (or your HERMES_HOME) and fill in.
# chmod 600 this file. NEVER commit real values.

TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_ALLOWED_USERS=YOUR_TELEGRAM_USER_ID
GATEWAY_ALLOWED_USERS=YOUR_TELEGRAM_USER_ID

# Optional: suppress "No home channel" nag (DM chat id is often your user id)
TELEGRAM_HOME_CHANNEL=YOUR_TELEGRAM_USER_ID
TELEGRAM_HOME_CHANNEL_NAME=my-dm

# Keep false / unset unless you intentionally want open access
# GATEWAY_ALLOW_ALL_USERS=false
